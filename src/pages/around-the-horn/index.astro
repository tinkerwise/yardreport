---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Around the Horn | Yard Report">
  <main class="ath-page">
    <div class="ath-page-shell">
      <a class="ath-page-back" href={`${import.meta.env.BASE_URL}`}>← Back to Yard Report</a>
      <header class="ath-page-head">
        <span class="ath-page-kicker">Around the Horn</span>
        <h1 class="ath-page-title" id="athPageTitle">Loading story…</h1>
        <p class="ath-page-subtitle" id="athPageSubtitle">Gathering related coverage from the saved bundle.</p>
      </header>
      <section class="ath-story-grid" id="athStoryGrid">
        <div class="feed-msg">Loading bundle…</div>
      </section>
    </div>
  </main>

  <script>
    import '../../scripts/around-the-horn.js';
  </script>
</Layout>
