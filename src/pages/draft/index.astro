---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="MLB Draft | Yard Report">
  <header class="site-header">
    <div class="header-inner">
      <a class="logo" href={base}>
        <img class="logo-img" src={`${base}logo.png`} alt="Yard Report logo" height="36" />
        <span class="logo-wordmark" aria-label="Yard Report">
          <span class="logo-word">Yard</span>
          <strong class="logo-word logo-word-accent">Report</strong>
        </span>
      </a>
      <nav class="header-right header-breadcrumb" aria-label="Breadcrumb">
        <a class="breadcrumb-link" href={base}>← Yard Report</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">MLB Draft</span>
      </nav>
    </div>
  </header>

  <main class="asg-page">
    <div class="asg-container">

      <div class="asg-main">
        <div class="asg-main-head">
          <h1 class="asg-title">2026 MLB Draft — Orioles Picks</h1>
          <span class="asg-updated" id="draftUpdated"></span>
        </div>

        <div class="asg-team-col" id="draftPicksCol">
          <div class="asg-team-head">Baltimore Orioles</div>
          <div id="draftPicks"><span class="sidebar-msg">Loading…</span></div>
        </div>

        <div class="asg-team-col draft-order-col">
          <div class="asg-team-head">Round 1 Order</div>
          <div id="draftOrder" class="draft-order-list"><span class="sidebar-msg">Loading…</span></div>
        </div>
      </div>

      <aside class="sidebar asg-sidebar">
        <div class="sidebar-section" data-section="draft-info">
          <h3 class="section-label">Draft Info</h3>
          <div class="section-body" id="draftInfo">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible" data-section="draft-news">
          <h3 class="section-label section-toggle" data-target="draft-news">
            Draft News
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="draftNews">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible collapsed" data-section="draft-history">
          <h3 class="section-label section-toggle" data-target="draft-history">
            Recent Orioles First Rounders
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="draftHistory">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<script>
  import '../../scripts/draft.js';
</script>
