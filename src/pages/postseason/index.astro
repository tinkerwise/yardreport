---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Postseason | Yard Report">
  <header class="site-header">
    <div class="header-inner">
      <a class="logo" href={base}>
        <img class="logo-img" src={`${base}logo.png`} alt="Yard Report logo" height="36" />
        <span class="logo-wordmark" aria-label="Yard Report">
          <span class="logo-word">Yard</span>
          <strong class="logo-word logo-word-accent">Report</strong>
        </span>
      </a>
      <nav class="header-right header-breadcrumb" aria-label="Breadcrumb">
        <a class="breadcrumb-link" href={base}>← Yard Report</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Postseason</span>
      </nav>
    </div>
  </header>

  <main class="asg-page">
    <div class="asg-container">

      <div class="asg-main">
        <div class="asg-main-head">
          <h1 class="asg-title">
            2026 Postseason
            <span class="info-trigger" tabindex="0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span class="info-popover">
                <p>Twelve teams make it — six per league. The three division winners with the best records are seeds 1–3, and the three best remaining records are the Wild Cards, seeds 4–6. Seeds 1 and 2 get a bye straight to the Division Series.</p>
                <p>Wild Card Series are best-of-three, all at the higher seed's park. Division Series are best-of-five; the League Championship Series and World Series are best-of-seven. Tap any matchup for its game-by-game results.</p>
              </span>
            </span>
          </h1>
          <span class="asg-updated" id="psUpdated"></span>
        </div>

        <div id="psSpotlight"></div>

        <div class="asg-team-col ps-section">
          <div class="asg-team-head asg-team-head-row">
            <span id="psTodayLabel">Today's Games</span>
            <span class="asg-updated" id="psTodayMeta"></span>
          </div>
          <div id="psToday" class="ps-games"><span class="sidebar-msg">Loading…</span></div>
        </div>

        <div class="asg-team-col ps-section">
          <div class="asg-team-head asg-team-head-row">
            <span>Bracket</span>
            <span class="asg-updated">Tap a matchup for game-by-game results · live series open Gameday</span>
          </div>
          <div id="psBracket" class="ps-bracket"><span class="sidebar-msg">Loading…</span></div>
          <div id="psSeriesDetail"></div>
        </div>

        <div class="asg-team-col ps-section">
          <div class="asg-team-head asg-team-head-row">
            <span>Postseason News</span>
            <span class="asg-updated" id="psNewsCount"></span>
          </div>
          <div class="pill-group ps-news-filters" id="psNewsFilters"></div>
          <div id="psNews" class="ps-news-grid"><span class="sidebar-msg">Loading…</span></div>
        </div>
      </div>

      <aside class="sidebar asg-sidebar">
        <div class="sidebar-section" data-section="ps-info">
          <h3 class="section-label">Postseason Schedule</h3>
          <div class="section-body" id="psInfo">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible" data-section="ps-leaders">
          <h3 class="section-label section-toggle" data-target="ps-leaders">
            Postseason Leaders
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="psLeaders">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible collapsed" data-section="ps-media">
          <h3 class="section-label section-toggle" data-target="ps-media">
            Video
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="psMedia">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>

        <div class="sidebar-section collapsible collapsed" data-section="ps-history">
          <h3 class="section-label section-toggle" data-target="ps-history">
            October History
            <svg class="section-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </h3>
          <div class="section-body" id="psHistory">
            <span class="sidebar-msg">Loading…</span>
          </div>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<script>
  import '../../scripts/postseason.js';
</script>
